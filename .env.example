# Environment variables for CADBot
# Copy this file to .env and fill in your values

# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_token_here

# Discord Application ID (from Discord Developer Portal)
APPLICATION_ID=your_application_id_here

# Discord Guild (Server) ID — slash commands are registered here
GUILD_ID=your_guild_id_here

# Channel ID for startup messages (optional, leave blank to skip)
STARTUP_CHANNEL_ID=

# Riot Games API Key
RIOT_API_KEY=your_riot_api_key_here

# Riot region (na1, euw1, eun1, kr, br1, la1, la2, oc1, tr1, ru, jp1)
RIOT_REGION=na1

# Riot regional routing (americas, europe, asia, sea)
RIOT_REGIONAL_ROUTING=americas
