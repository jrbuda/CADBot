# Compiled output
node_modules/

# Environment variables — NEVER commit this
.env

# Logs — keep directory with .gitkeep, ignore generated files
logs/*
!logs/.gitkeep

# Runtime data — keep directory with .gitkeep + seed files, ignore generated files
data/*
!data/.gitkeep
!data/config.json
!data/players.json
!data/teams.json
!data/availability.json
!data/scrims.json
!data/sessions.json

# OS
.DS_Store
Thumbs.db
